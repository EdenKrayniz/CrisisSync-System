@startuml
left to right direction

' --- Primary Actors ---
actor "System Administrator" as admin
actor "Logistics & Resources Officer" as logistics
actor "Dispatcher" as dispatcher
actor "Field Commander" as commander
actor "Field Crew Member" as crew

' --- Secondary Actors / External Systems ---
actor "National Clearing System" as clearing <<System>>

' --- System Boundary ---
rectangle "CrisisSync System" {
    usecase "Manage Accounts & Permissions" as UC_ManageAccounts
    usecase "Load Initial Data" as UC_LoadData
    usecase "Generate Reports" as UC_GenerateReports
    usecase "Manage Resource Inventory" as UC_ManageResources
    usecase "Open / Cancel Event" as UC_ManageEvent
    usecase "Build Task Tree (DAG)" as UC_BuildTasks
    usecase "Reserve Resources" as UC_Reserve
    usecase "Auto-Allocate Resources" as UC_AutoReserve
    usecase "Track Real-Time Status" as UC_TrackStatus
    usecase "Report Task Completion" as UC_ReportTask
    usecase "Report Equipment Fault" as UC_ReportFault
    usecase "Close Event" as UC_CloseEvent
    usecase "Process Billing Settlement" as UC_Billing
}

' --- UML Associations (Solid lines, NO arrows) ---
admin -- UC_ManageAccounts
admin -- UC_LoadData
admin -- UC_GenerateReports

logistics -- UC_ManageResources

dispatcher -- UC_ManageEvent
dispatcher -- UC_BuildTasks
dispatcher -- UC_Reserve
dispatcher -- UC_TrackStatus
dispatcher -- UC_CloseEvent

commander -- UC_TrackStatus
commander -- UC_ReportTask
commander -- UC_ReportFault

crew -- UC_TrackStatus
crew -- UC_ReportFault

' --- External Systems Associations ---
UC_Billing -- clearing

' --- Dependencies: <<include>> and <<extend>> ---
' Closing an event strictly includes sending a billing request to the external system
UC_CloseEvent ..> UC_Billing : <<include>>

' Automated allocation is an optional extension of the standard manual resource reservation
UC_AutoReserve ..> UC_Reserve : <<extend>>

@enduml
